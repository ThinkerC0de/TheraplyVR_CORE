  contract:
    schema: 'THERAPLY_MOBILE_CONTROL_LAYOUT'
    schemaVersion: '2026-02-26'
    gameId: 'bilateral_markers'
    title: 'Bilateral Markers Controls'
    description: 'START_GAME setup for bilateral hand-path training on Quest controllers.'
    layout:
      mode: 'stack'
      columns: 1
    payload:
      target: 'game_config'
      gameConfigType: 'bilateral_markers_config'
      gameConfigVersion: 1
      includeVersionInGameConfig: 1
    sections:
    - sectionId: 'core'
      label: 'Core'
      order: 10
    - sectionId: 'advanced'
      label: 'Advanced'
      order: 20
    controls:
    - controlId: 'level'
      type: 'select'
      label: 'Difficulty Level'
      description: 'Therapeutic mode from 0 to 4.'
      placeholder: 
      sectionId: 'core'
      order: 10
      defaultValue: '0'
      bindingKey: 'level'
      bindingTarget: 'game_config'
      valueType: 'int'
      emitOnStartGame: 1
      emitOnUpdateConfig: 0
      buttonCommandId: 
      required: 1
      minValue: 
      maxValue: 
      step: 
      minLength: 0
      maxLength: 0
      regex: 
      visual:
        x: -1
        y: -1
        width: 1
        height: 1
        scale: 1
      options:
      - value: '0'
        label: '0 Symmetry'
      - value: '1'
        label: '1 Mirror'
      - value: '2'
        label: '2 Rotational'
      - value: '3'
        label: '3 Asymmetry'
      - value: '4'
        label: '4 Alternating'
    - controlId: 'pattern'
      type: 'select'
      label: 'Primary Pattern'
