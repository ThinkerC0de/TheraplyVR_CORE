  m_Name: BilateralMarkersFlowDefinition
  m_EditorClassIdentifier: 
  definition:
    gameId: 'bilateral_markers'
    displayName: 'Bilateral Markers Flow Definition'
    commentVersion: '2026-02-26 bilateral markers production baseline'
    controlMode: 'remote_only'
    config:
      difficulty: 'custom'
      timeLimitSec: 90
      targetCount: 1
      extras:
      - key: 'level'
        value: '0'
      - key: 'tempoBpm'
        value: '72'
    bindings:
      objects: []
      zones: []
      audio: []
      timeline: []
    channels:
    - channelId: 'pointer'
      enabled: 0
    - channelId: 'tool_impact'
      enabled: 0
    - channelId: 'hand_contact'
      enabled: 0
    - channelId: 'hand_grab'
      enabled: 0
    - channelId: 'gaze'
      enabled: 0
    - channelId: 'breath'
      enabled: 0
    - channelId: 'audio_source'
      enabled: 0
    - channelId: 'dual_hand'
      enabled: 1
    - channelId: 'pose_path'
      enabled: 1
    - channelId: 'sequence'
      enabled: 0
    - channelId: 'timeline'
      enabled: 1
    policies:
      wrongActionPolicy: 'warn'
      retryPolicy:
        maxRetries: 3
        cooldownSec: 0.5
      timeoutPolicy:
        defaultTimeoutSec: 90.0
      branchPolicy:
        precedence: 'first_match'
      scoringPolicy:
        lives: 1
        pointsPerCorrect: 1
        pointsPerWrong: -1
      difficultyPolicy:
        adaptiveEnabled: 1
      safetyPolicy:
        emergencyStopEnabled: 1
        rejectDisabledChannels: 1
      controlPolicy:
        mode: 'remote_only'
      telemetryPolicy:
        requireDecisionForEveryAction: 1
      localizationPolicy:
        defaultLocale: 'en-US'
        fallbackToLanguageCode: 1
        fallbackLocales:
        - 'pl'
      calendarPolicy:
        timezoneId: 'UTC'
        fallbackToUtcWhenTimezoneInvalid: 1
        allowQaTimeOverride: 1
        defaultProfileDateKey: 'profile_birthday'
        conflictPolicy: 'highest_priority'
        rules: []
        events: []
    taskGraph:
      entryNodeId: 'n_sync'
      nodes:
      - nodeId: 'n_sync'
        nodeType: 'Action'
        allowedActions:
        - actionId: 'mark_left_and_right_targets'
          targetGroup: 'bilateral_sync'
          constraints:
          - key: 'requiredChannelId'
            value: 'dual_hand'
        conditions: []
        timeoutSec: 12.0
        onEnterEffects:
        - effectId: 'emit_hint'
          binding: 'bilateral_hint'
          parameters:
          - key: 'message'
            value: 'Start moving both hands on their paths.'
        onExitEffects: []
        onAcceptedEffects: []
        onRejectedEffects: []
        onTimeoutEffects: []
        nextOnSuccess: 'n_path'
        nextOnFail: 'n_fail'
        nextOnTimeout: 'n_fail'
      - nodeId: 'n_path'
        nodeType: 'Action'
        allowedActions:
        - actionId: 'follow_path'
          targetGroup: 'bilateral_paths'
          constraints:
          - key: 'requiredChannelId'
            value: 'pose_path'
        conditions: []
        timeoutSec: 90.0
        onEnterEffects: []
        onExitEffects: []
        onAcceptedEffects: []
        onRejectedEffects: []
        onTimeoutEffects: []
        nextOnSuccess: 'n_complete'
        nextOnFail: 'n_fail'
        nextOnTimeout: 'n_fail'
      - nodeId: 'n_complete'
        nodeType: 'Complete'
        allowedActions: []
        conditions: []
        timeoutSec: 0.0
        onEnterEffects: []
        onExitEffects: []
        onAcceptedEffects: []
        onRejectedEffects: []
        onTimeoutEffects: []
        nextOnSuccess: 
        nextOnFail: 
        nextOnTimeout: 
      - nodeId: 'n_fail'
        nodeType: 'Fail'
        allowedActions: []
        conditions: []
        timeoutSec: 0.0
        onEnterEffects: []
        onExitEffects: []
        onAcceptedEffects: []
        onRejectedEffects: []
        onTimeoutEffects: []
        nextOnSuccess: 
        nextOnFail: 
        nextOnTimeout: 
