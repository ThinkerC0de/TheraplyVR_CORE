  m_Script: {fileID: 11500000, guid: 34db9a22f10e48bb8d2a62f9fd822e05, type: 3}
  m_Name: PuzzlePathsFlowDefinition
  m_EditorClassIdentifier: 
  definition:
    gameId: puzzle_paths
    displayName: Puzzle Paths Flow Definition
    commentVersion: 2026-02-25 puzzle authoring sample
    controlMode: hybrid
    config:
      difficulty: normal
      timeLimitSec: 180
      targetCount: 20
      extras:
      - key: puzzleMode
        value: basic
    bindings:
      objects: []
      zones: []
      audio: []
      timeline: []
    channels:
    - channelId: pointer
      enabled: 1
    - channelId: tool_impact
      enabled: 1
    - channelId: hand_contact
      enabled: 0
    - channelId: hand_grab
      enabled: 0
    - channelId: gaze
      enabled: 0
    - channelId: breath
      enabled: 0
    - channelId: audio_source
      enabled: 0
    - channelId: dual_hand
      enabled: 0
    - channelId: pose_path
      enabled: 0
    - channelId: sequence
      enabled: 0
    - channelId: timeline
      enabled: 0
    policies:
      wrongActionPolicy: warn
      retryPolicy:
        maxRetries: 3
        cooldownSec: 0.5
      timeoutPolicy:
        defaultTimeoutSec: 15
      branchPolicy:
        precedence: first_match
      scoringPolicy:
        lives: 3
        pointsPerCorrect: 1
        pointsPerWrong: -1
      difficultyPolicy:
        adaptiveEnabled: 1
      safetyPolicy:
        emergencyStopEnabled: 1
        rejectDisabledChannels: 1
      controlPolicy:
        mode: hybrid
      telemetryPolicy:
        requireDecisionForEveryAction: 1
      localizationPolicy:
        defaultLocale: en-US
        fallbackToLanguageCode: 1
        fallbackLocales:
        - pl
      calendarPolicy:
        timezoneId: UTC
        fallbackToUtcWhenTimezoneInvalid: 1
        allowQaTimeOverride: 1
        defaultProfileDateKey: profile_birthday
        conflictPolicy: highest_priority
        rules: []
        events: []
    taskGraph:
      entryNodeId: n_action
      nodes:
      - nodeId: n_action
        nodeType: Action
        allowedActions:
        - actionId: touch_target_with_tool
          targetGroup: puzzle_target
          constraints:
          - key: requiredChannelId
            value: pointer
        conditions: []
        timeoutSec: 12
        onEnterEffects:
        - effectId: emit_hint
          binding: demo_hint
          parameters:
          - key: message
            value: Place highlighted puzzle piece
        onExitEffects: []
        onAcceptedEffects: []
        onRejectedEffects: []
        onTimeoutEffects: []
        nextOnSuccess: n_branch
        nextOnFail: n_fail
        nextOnTimeout: n_fail
      - nodeId: n_branch
        nodeType: Branch
        allowedActions: []
        conditions:
        - conditionId: score_threshold
          subject: scoreTotal
          op: '>='
          value: 5
          nextNodeId: n_complete
        timeoutSec: 0
        onEnterEffects: []
        onExitEffects: []
        onAcceptedEffects: []
        onRejectedEffects: []
        onTimeoutEffects: []
        nextOnSuccess: n_timer
        nextOnFail: n_timer
        nextOnTimeout: n_fail
      - nodeId: n_timer
        nodeType: Timer
        allowedActions: []
        conditions: []
        timeoutSec: 30
        onEnterEffects: []
        onExitEffects: []
        onAcceptedEffects: []
        onRejectedEffects: []
        onTimeoutEffects: []
        nextOnSuccess: n_complete
        nextOnFail: n_fail
        nextOnTimeout: n_complete
      - nodeId: n_complete
        nodeType: Complete
        allowedActions: []
        conditions: []
        timeoutSec: 0
        onEnterEffects: []
        onExitEffects: []
        onAcceptedEffects: []
        onRejectedEffects: []
        onTimeoutEffects: []
        nextOnSuccess: 
        nextOnFail: 
        nextOnTimeout: 
      - nodeId: n_fail
        nodeType: Fail
        allowedActions: []
        conditions: []
        timeoutSec: 0
        onEnterEffects: []
        onExitEffects: []
        onAcceptedEffects: []
        onRejectedEffects: []
        onTimeoutEffects: []
        nextOnSuccess: 
        nextOnFail: 
        nextOnTimeout: 
    mobileControlSchema:
      schema: THERAPLY_MOBILE_CONTROL_SCHEMA
      schemaVersion: 2026-02-25
      gameId: puzzle_paths
      title: Puzzle Paths Dynamic Controls
      description: Dynamic setup rendered from schema with update button.
      layout:
        mode: stack
        columns: 1
      payload:
        target: game_config
        gameConfigType: puzzle_paths_config_v1
        gameConfigVersion: 1
        includeVersionInGameConfig: 1
      sections:
      - sectionId: setup
        label: Setup
        order: 10
      - sectionId: runtime
        label: Runtime
        order: 20
      controls:
      - controlId: piece_count
        type: slider
        label: Piece Count
        hint: Number of active cubes.
        placeholder: 
        sectionId: setup
        order: 10
        defaultValue: 12
        buttonCommandId: UPDATE_CONFIG
        binding:
          target: game_config
          path: pieceCount
          valueType: int
          emitOnStartGame: 1
          emitOnUpdateConfig: 1
        validation:
          required: 1
          minValue: 4
          maxValue: 40
          step: 1
          minLength: 0
          maxLength: 0
          regex: 
        options: []
      - controlId: rotation_speed
        type: slider
        label: Puzzle Rotation Speed
        hint: Movement speed multiplier.
        placeholder: 
        sectionId: setup
        order: 20
        defaultValue: 0.7
        buttonCommandId: UPDATE_CONFIG
        binding:
          target: game_config
          path: rotationSpeed
          valueType: double
          emitOnStartGame: 1
          emitOnUpdateConfig: 1
        validation:
          required: 1
          minValue: 0.2
          maxValue: 2.2
          step: 0.1
          minLength: 0
          maxLength: 0
          regex: 
        options: []
      - controlId: puzzle_mode
        type: select
        label: Puzzle Mode
        hint: Select progression mode.
        placeholder: 
        sectionId: setup
        order: 30
        defaultValue: basic
        buttonCommandId: UPDATE_CONFIG
        binding:
          target: game_config
          path: puzzleMode
          valueType: string
          emitOnStartGame: 1
          emitOnUpdateConfig: 1
        validation:
          required: 1
          minValue: 
          maxValue: 
          step: 
          minLength: 0
          maxLength: 0
          regex: 
        options:
        - value: basic
          label: Basic
        - value: alternate_colors
          label: Alternate Colors
        - value: random_target_color
          label: Random Target
      - controlId: session_note
        type: text
        label: Session Note
        hint: Optional note sent with update config.
        placeholder: Note for runtime log
        sectionId: runtime
        order: 40
        defaultValue: 
        buttonCommandId: UPDATE_CONFIG
        binding:
          target: game_config
          path: sessionNote
          valueType: string
          emitOnStartGame: 0
          emitOnUpdateConfig: 1
        validation:
          required: 0
          minValue: 
          maxValue: 
          step: 
          minLength: 0
          maxLength: 120
          regex: 
        options: []
      - controlId: apply_runtime_update
