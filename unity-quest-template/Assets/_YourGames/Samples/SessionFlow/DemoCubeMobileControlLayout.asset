        x: -1
        y: -1
        width: 1
        height: 1
        scale: 1
      options: []
    - controlId: level_mode
      type: select
      label: Level Mode
      description: Target color rule set.
      placeholder: 
      sectionId: setup
      order: 30
      defaultValue: basic
      bindingKey: levelMode
      bindingTarget: game_config
      valueType: string
      emitOnStartGame: 1
      emitOnUpdateConfig: 1
      buttonCommandId: 
      required: 1
      minValue: 
      maxValue: 
      step: 
      minLength: 0
      maxLength: 0
      regex: 
      visual:
        x: -1
        y: -1
        width: 1
        height: 1
        scale: 1
      options:
      - value: basic
        label: Basic
      - value: alternate_colors
        label: Alternate Colors
      - value: random_target_color
        label: Random Target
    - controlId: resume_from_saved
      type: toggle
