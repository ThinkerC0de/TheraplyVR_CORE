  contract:
    schema: THERAPLY_MOBILE_CONTROL_LAYOUT
    schemaVersion: 2026-02-27
    gameId: demo_cube_clicker
    title: Demo Cube Controls
    description: Schema-driven controls for Demo Cube START_GAME and UPDATE_CONFIG.
    layout:
      mode: stack
      columns: 1
    payload:
      target: game_config
      gameConfigType: demo_cube_config_v1
      gameConfigVersion: 1
      includeVersionInGameConfig: 1
    sections:
    - sectionId: setup
      label: Setup
      order: 10
    - sectionId: runtime
      label: Runtime
      order: 20
    controls:
    - controlId: cube_count
      type: slider
      label: Cube Count
      description: Number of spawned cubes.
      placeholder: 
      sectionId: setup
      order: 10
      defaultValue: 12
      bindingKey: cubeCount
      bindingTarget: game_config
      valueType: int
      emitOnStartGame: 1
      emitOnUpdateConfig: 1
      buttonCommandId: 
      required: 1
      minValue: 4
      maxValue: 40
      step: 1
      minLength: 0
      maxLength: 0
      regex: 
      visual:
        x: -1
        y: -1
        width: 1
        height: 1
        scale: 1
      options: []
    - controlId: cube_speed
      type: slider
      label: Cube Speed
      description: Cube movement speed.
      placeholder: 
      sectionId: setup
      order: 20
      defaultValue: 0.7
      bindingKey: cubeSpeed
      bindingTarget: game_config
      valueType: double
      emitOnStartGame: 1
      emitOnUpdateConfig: 1
      buttonCommandId: 
      required: 1
