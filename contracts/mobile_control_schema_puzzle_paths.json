{
    "schema": "THERAPLY_MOBILE_CONTROL_SCHEMA",
    "schemaVersion": "2026-02-25",
    "gameId": "puzzle_paths",
    "title": "Puzzle Paths Dynamic Controls",
    "description": "Dynamic setup rendered from schema with update button.",
    "layout": {
        "mode": "stack",
        "columns": 1
    },
    "payload": {
        "target": "game_config",
        "gameConfigType": "puzzle_paths_config_v1",
        "gameConfigVersion": 1,
        "includeVersionInGameConfig": true
    },
    "sections": [
        {
            "sectionId": "setup",
            "label": "Setup",
            "order": 10
        },
        {
            "sectionId": "runtime",
            "label": "Runtime",
            "order": 20
        }
    ],
    "controls": [
        {
            "controlId": "piece_count",
            "type": "slider",
            "label": "Piece Count",
            "hint": "Number of active cubes.",
            "placeholder": "",
            "sectionId": "setup",
            "order": 10,
            "defaultValue": "12",
            "buttonCommandId": "UPDATE_CONFIG",
            "binding": {
                "target": "game_config",
                "path": "pieceCount",
                "valueType": "int",
                "emitOnStartGame": true,
                "emitOnUpdateConfig": true
            },
            "validation": {
                "required": true,
                "minValue": "4",
                "maxValue": "40",
                "step": "1",
                "minLength": 0,
                "maxLength": 0,
                "regex": ""
            },
            "options": []
        },
        {
            "controlId": "rotation_speed",
            "type": "slider",
            "label": "Puzzle Rotation Speed",
            "hint": "Movement speed multiplier.",
            "placeholder": "",
            "sectionId": "setup",
            "order": 20,
            "defaultValue": "0.7",
            "buttonCommandId": "UPDATE_CONFIG",
            "binding": {
                "target": "game_config",
                "path": "rotationSpeed",
                "valueType": "double",
                "emitOnStartGame": true,
                "emitOnUpdateConfig": true
            },
            "validation": {
                "required": true,
                "minValue": "0.2",
                "maxValue": "2.2",
                "step": "0.1",
                "minLength": 0,
                "maxLength": 0,
                "regex": ""
            },
            "options": []
        },
        {
            "controlId": "puzzle_mode",
            "type": "select",
            "label": "Puzzle Mode",
            "hint": "Select progression mode.",
            "placeholder": "",
            "sectionId": "setup",
            "order": 30,
            "defaultValue": "basic",
            "buttonCommandId": "UPDATE_CONFIG",
            "binding": {
                "target": "game_config",
                "path": "puzzleMode",
                "valueType": "string",
                "emitOnStartGame": true,
                "emitOnUpdateConfig": true
            },
            "validation": {
                "required": true,
                "minValue": "",
                "maxValue": "",
                "step": "",
                "minLength": 0,
                "maxLength": 0,
                "regex": ""
            },
            "options": [
                {
                    "value": "basic",
                    "label": "Basic"
                },
                {
                    "value": "alternate_colors",
                    "label": "Alternate Colors"
                },
                {
                    "value": "random_target_color",
                    "label": "Random Target"
                }
            ]
        },
        {
            "controlId": "session_note",
            "type": "text",
            "label": "Session Note",
            "hint": "Optional note sent with update config.",
            "placeholder": "Note for runtime log",
            "sectionId": "runtime",
            "order": 40,
            "defaultValue": "",
            "buttonCommandId": "UPDATE_CONFIG",
            "binding": {
                "target": "game_config",
                "path": "sessionNote",
                "valueType": "string",
                "emitOnStartGame": false,
                "emitOnUpdateConfig": true
            },
            "validation": {
                "required": false,
                "minValue": "",
                "maxValue": "",
                "step": "",
                "minLength": 0,
                "maxLength": 120,
                "regex": ""
            },
            "options": []
        },
        {
            "controlId": "apply_runtime_update",
            "type": "button",
            "label": "Apply Runtime Config",
            "hint": "Send UPDATE_CONFIG with current control values.",
            "placeholder": "",
            "sectionId": "runtime",
            "order": 50,
            "defaultValue": "",
            "buttonCommandId": "UPDATE_CONFIG",
            "binding": {
                "target": "game_config",
                "path": "",
                "valueType": "string",
                "emitOnStartGame": false,
                "emitOnUpdateConfig": false
            },
            "validation": {
                "required": false,
                "minValue": "",
                "maxValue": "",
                "step": "",
                "minLength": 0,
                "maxLength": 0,
                "regex": ""
            },
            "options": []
        }
    ]
}
