                "order": 10,
                "defaultValue": "12",
                "buttonCommandId": "UPDATE_CONFIG",
                "binding": {
                    "target": "game_config",
                    "path": "cubeCount",
                    "valueType": "int",
                    "emitOnStartGame": true,
                    "emitOnUpdateConfig": true
