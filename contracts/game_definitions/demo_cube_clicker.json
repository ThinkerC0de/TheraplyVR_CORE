                "order": 10
            },
            {
                "sectionId": "runtime",
                "label": "Runtime",
                "order": 20
            }
        ],
        "controls": [
            {
                "controlId": "cube_count",
                "type": "slider",
                "label": "Cube Count",
                "hint": "Number of active cubes.",
                "placeholder": "",
