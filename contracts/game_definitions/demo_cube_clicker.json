    "mobileControlSchema": {
        "schema": "THERAPLY_MOBILE_CONTROL_SCHEMA",
        "schemaVersion": "2026-02-25",
        "gameId": "demo_cube_clicker",
        "title": "Demo Cube Dynamic Controls",
        "description": "Dynamic setup rendered from schema with update button.",
        "layout": {
            "mode": "stack",
            "columns": 1
        },
        "payload": {
            "target": "game_config",
            "gameConfigType": "demo_cube_config_v1",
            "gameConfigVersion": 1,
            "includeVersionInGameConfig": true
