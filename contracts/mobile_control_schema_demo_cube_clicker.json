{
    "schema": "THERAPLY_MOBILE_CONTROL_SCHEMA",
    "schemaVersion": "2026-02-27",
    "gameId": "demo_cube_clicker",
    "title": "Demo Cube Controls",
    "description": "Schema-driven controls for Demo Cube START_GAME and UPDATE_CONFIG.",
    "layout": {
        "mode": "grid",
        "columns": 2
    },
    "payload": {
        "target": "game_config",
        "gameConfigType": "demo_cube_config_v1",
        "gameConfigVersion": 1,
        "includeVersionInGameConfig": true
    },
    "sections": [
        {
            "sectionId": "setup",
            "label": "Setup",
            "order": 10
        },
        {
            "sectionId": "runtime",
            "label": "Runtime",
            "order": 20
        }
    ],
    "controls": [
        {
            "controlId": "cube_count",
            "type": "slider",
            "label": "Cube Count",
            "hint": "Number of spawned cubes.",
            "placeholder": "",
            "sectionId": "setup",
            "order": 10,
            "defaultValue": "12",
            "buttonCommandId": "UPDATE_CONFIG",
            "binding": {
                "target": "game_config",
                "path": "cubeCount",
                "valueType": "int",
                "emitOnStartGame": true,
                "emitOnUpdateConfig": true
            },
            "validation": {
                "required": true,
                "minValue": "4",
                "maxValue": "40",
                "step": "1",
                "minLength": 0,
                "maxLength": 0,
                "regex": ""
            },
            "visual": {
                "x": 0.0,
