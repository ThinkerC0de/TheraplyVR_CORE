{
  "schema": "THERAPLY_MOBILE_CONTROL_SCHEMA",
  "schemaVersion": "2026-02-25",
  "gameId": "demo_cube_clicker",
  "title": "Demo Cube Dynamic Controls",
  "description": "Dynamic setup rendered from schema with runtime update button.",
  "layout": {
    "mode": "stack",
    "columns": 1
  },
  "payload": {
    "target": "game_config",
    "gameConfigType": "demo_cube_config_v1",
    "gameConfigVersion": 1,
    "includeVersionInGameConfig": true
  },
  "sections": [
    {
      "sectionId": "setup",
      "label": "Setup",
      "order": 10
    },
    {
      "sectionId": "runtime",
      "label": "Runtime",
      "order": 20
    }
  ],
  "controls": [
    {
      "controlId": "cube_count",
      "type": "slider",
      "label": "Cube Count",
      "hint": "Number of active cubes.",
      "sectionId": "setup",
      "order": 10,
      "defaultValue": "12",
      "binding": {
        "target": "game_config",
        "path": "cubeCount",
        "valueType": "int",
        "emitOnStartGame": true,
        "emitOnUpdateConfig": true
      },
      "validation": {
        "required": true,
        "minValue": "4",
        "maxValue": "40",
        "step": "1"
      },
      "options": []
    },
    {
      "controlId": "cube_speed",
      "type": "slider",
      "label": "Cube Speed",
      "hint": "Movement speed multiplier.",
      "sectionId": "setup",
      "order": 20,
      "defaultValue": "0.7",
      "binding": {
        "target": "game_config",
        "path": "cubeSpeed",
        "valueType": "double",
        "emitOnStartGame": true,
        "emitOnUpdateConfig": true
      },
      "validation": {
        "required": true,
        "minValue": "0.2",
        "maxValue": "2.2",
        "step": "0.1"
      },
      "options": []
    },
    {
      "controlId": "level_mode",
      "type": "select",
      "label": "Level Mode",
      "hint": "Select progression mode.",
      "sectionId": "setup",
      "order": 30,
      "defaultValue": "basic",
      "binding": {
        "target": "game_config",
        "path": "levelMode",
        "valueType": "string",
        "emitOnStartGame": true,
        "emitOnUpdateConfig": true
      },
      "validation": {
        "required": true
      },
      "options": [
        {
          "value": "basic",
          "label": "Basic"
        },
        {
          "value": "alternate_colors",
          "label": "Alternate Colors"
        },
        {
          "value": "random_target_color",
          "label": "Random Target"
        }
      ]
    },
    {
      "controlId": "therapist_note",
      "type": "text",
      "label": "Session Note",
      "hint": "Optional note sent with update config.",
      "placeholder": "Note for runtime log",
      "sectionId": "runtime",
      "order": 40,
      "defaultValue": "",
      "binding": {
        "target": "game_config",
        "path": "therapistNote",
        "valueType": "string",
        "emitOnStartGame": false,
        "emitOnUpdateConfig": true
      },
      "validation": {
        "required": false,
        "maxLength": 120
      },
      "options": []
    },
    {
      "controlId": "apply_runtime_update",
      "type": "button",
      "label": "Apply Runtime Config",
      "hint": "Send UPDATE_CONFIG with current control values.",
      "sectionId": "runtime",
      "order": 50,
      "buttonCommandId": "UPDATE_CONFIG",
      "options": []
    }
  ]
}
