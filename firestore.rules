rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdminOperator() {
      return isSignedIn() && (
        request.auth.token.admin_operator == true ||
        request.auth.token.role == 'admin_operator'
      );
    }

    function isTherapySessionOwnerByRequest() {
      return isSignedIn() &&
        request.resource != null &&
        request.resource.data.therapistId == request.auth.uid;
    }

    function isTherapySessionOwnerByResource() {
      return isSignedIn() &&
        resource != null &&
        resource.data.therapistId == request.auth.uid;
    }

    function canReadTherapySession(sessionId) {
      return isAdminOperator() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/therapy_sessions/$(sessionId)) &&
        get(/databases/$(database)/documents/therapy_sessions/$(sessionId)).data.therapistId == request.auth.uid
      );
    }

    match /user_entitlements/{userId} {
      allow read: if isSignedIn() && (
        isAdminOperator() || request.auth.uid == userId
      );
      allow create, update, delete: if isAdminOperator();
    }

    match /entitlement_grants/{grantId} {
      allow read: if isSignedIn() && (
        isAdminOperator() || resource.data.granteeUserId == request.auth.uid
      );
      allow create, update, delete: if isAdminOperator();
    }

    match /entitlement_grant_requests/{requestId} {
      allow read: if isSignedIn() && (
        isAdminOperator() || resource.data.requestedForUserId == request.auth.uid
      );
      allow create, update, delete: if isAdminOperator();
    }

    match /therapist_session_settings/{therapistId} {
      allow read: if isSignedIn() && (
        isAdminOperator() || request.auth.uid == therapistId
      );
      allow create, update, delete: if isSignedIn() && (
        isAdminOperator() || request.auth.uid == therapistId
      );
    }

    // Keep existing mobile student flow stable while allowing admin directory views.
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow create: if isAdminOperator() || (
        isSignedIn() && request.resource.data.therapistId == request.auth.uid
      );
      allow update, delete: if isAdminOperator() || (
        isSignedIn() && resource.data.therapistId == request.auth.uid
      );
    }

    match /student_access_bindings/{bindingId} {
      allow read: if isSignedIn();
      allow create: if isAdminOperator() || (
        isSignedIn() && request.resource.data.grantedBy == request.auth.uid
      );
      allow update, delete: if isAdminOperator() || (
        isSignedIn() && resource.data.grantedBy == request.auth.uid
      );
    }

    match /admin_audit_trail/{auditId} {
      allow read: if isAdminOperator();
      allow create: if isAdminOperator() &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.actorRole == 'admin_operator' &&
        request.resource.data.reason is string &&
        request.resource.data.correlationId is string;
      allow update, delete: if false;
    }

    match /therapy_sessions/{sessionId} {
      allow read: if isAdminOperator() || isTherapySessionOwnerByResource();
      allow create: if isAdminOperator() || isTherapySessionOwnerByRequest();
      allow update, delete: if isAdminOperator() || isTherapySessionOwnerByResource();

      // Legacy event subcollection — kept for backwards compatibility.
      match /events/{eventId} {
        allow read: if canReadTherapySession(sessionId);
        allow create: if isAdminOperator() || (
          canReadTherapySession(sessionId) &&
          request.resource != null &&
          request.resource.data.therapistId == request.auth.uid
        );
        allow update, delete: if false;
      }

      // Written exclusively by Cloud Functions (admin SDK bypasses these rules).
      // Client-side reads allowed for session owner and admin.
      match /game_runs/{gameRunId} {
        allow read: if canReadTherapySession(sessionId);
        allow write: if false;
      }

      match /interactions/{eventId} {
        allow read: if canReadTherapySession(sessionId);
        allow write: if false;
      }

      match /motion_traces/{traceId} {
        allow read: if canReadTherapySession(sessionId);
        allow write: if false;
      }

      // Raw / unknown events — admin only.
      match /raw_events/{eventId} {
        allow read: if isAdminOperator();
        allow write: if false;
      }
    }

    match /operator_incident_reports/{reportId} {
      allow read: if isAdminOperator() || (
        isSignedIn() && resource.data.actorUid == request.auth.uid
      );
      allow create: if isSignedIn() &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.reportId == reportId &&
        request.resource.data.queueName is string &&
        request.resource.data.generatedAtUtc is string &&
        request.resource.data.submittedAtUtc is string &&
        request.resource.data.incidentCount is int &&
        request.resource.data.incidents is list;
      allow update, delete: if false;
    }

    match /game_catalog/{gameId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdminOperator();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
