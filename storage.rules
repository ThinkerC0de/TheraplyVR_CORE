rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // motion_traces/{sessionId}/{gameRunId}/{filename}
    // Written by the mobile controller (authenticated therapist).
    // Read by authenticated users who have access to the session.
    match /motion_traces/{sessionId}/{gameRunId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 2 * 1024 * 1024  // max 2 MB per trace
        && (fileName.matches('.*\\.vrl(\\.gz)?'));
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
